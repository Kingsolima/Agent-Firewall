# Agent Firewall — environment configuration
#
# Copy to .env and fill in. Only ANTHROPIC_API_KEY is strictly required: with
# just that, the engine, proxy, dashboard, and demo all run on the in-process
# `memory` backend. Everything else is optional and additive.
#
#   cp .env.example .env

# =============================================================== REQUIRED
# Claude API — powers injection detection, intent extraction, drift scoring,
# and counterfactual generation. Read automatically by the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...


# ======================================================= SESSION MEMORY
# Where a session's intent (and durable taint) is stored.
#   memory    — in-process, no external dependency. Default; the demo runs on it.
#   supabase  — the intent_store table; survives restarts, needs Supabase below.
#   backboard — durable memory + derived taint facts, needs Backboard below.
FIREWALL_MEMORY_BACKEND=memory


# ================================================ BACKBOARD (optional)
# Durable session memory: the armed intent plus short DERIVED facts about what
# the agent ingested (never raw tool output, never secret values). Enables the
# durability demo (`python demo/run_demo.py --durability`) and the privacy demo
# (`python demo/show_memory.py`). If unset, the firewall behaves exactly as it
# does on the `memory` backend.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=                    # optional — pin an existing assistant; created on first use otherwise
# BACKBOARD_ASSISTANT_NAME=agent-firewall-session-memory
# BACKBOARD_BASE_URL=https://app.backboard.io/api


# ================================================= SUPABASE (optional)
# Backs the audit log (the dashboard's historical panel) and the `supabase`
# memory backend. The live console does NOT need this — it reads an in-process
# feed. Note: free-tier projects auto-pause when idle; un-pause before use.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                 # service role key, NOT the publishable key (Dashboard > Settings > API)


# ==================================================== PROXY <-> ENGINE
# Where the MCP proxy reaches the reasoning engine. Change for a deployed engine.
OMAR_PIPELINE_URL=http://localhost:8001

# Shared session id across co-wrapped MCP servers, so a read on one server and a
# send on another correlate as one session. Normally injected per-launch by the
# config helper; set it explicitly to make a demo session reproducible.
# FIREWALL_SESSION_ID=demo-session-1

# How long a HELD call waits for a human approve/deny before failing closed to
# BLOCK. Keep at/under the MCP host's own tools/call timeout (~60s in Claude
# Desktop) so the host doesn't cancel the call first.
# FIREWALL_HOLD_TIMEOUT=55                 # proxy-side read budget
# DASH_HOLD_TIMEOUT=55                     # engine-side park duration


# =========================================================== TUNING
# Reasoning model. haiku-4-5 is fast and accurate for these structured
# classification tasks, which matters for the per-call latency budget.
# PIPELINE_MODEL=claude-haiku-4-5

# Per-component timeout inside the engine. A healthy warm Claude call is ~1s;
# this catches a genuinely stuck one without killing a slow-but-fine one.
# STAGE_TIMEOUT_SECONDS=6.0
